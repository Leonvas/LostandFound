# Frontend (Vite) env vars — used for direct browser uploads to Supabase Storage.
# These are the PUBLIC anon key, safe to ship in the browser bundle as long as
# Storage policies on the "item-photos" bucket are set correctly.
# Copy this file to .env and fill in your project's values (Supabase
# dashboard -> Project Settings -> API).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
